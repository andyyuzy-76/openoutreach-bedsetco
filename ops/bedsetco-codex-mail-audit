#!/usr/bin/env python3
"""Read-only mail audit endpoint for the BedsetCo Codex automation.

This program is intended to be installed as an SSH authorized_keys forced
command.  It accepts one small JSON request on stdin and returns one JSON
response on stdout.  It cannot send mail, alter the Postfix queue, or modify
mailboxes.
"""

from __future__ import annotations

import datetime as dt
import glob
import gzip
import hashlib
import json
import os
import re
import socket
import subprocess
import sys
from collections import deque
from typing import Any, Iterable


MAX_REQUEST_BYTES = 8192
MAX_RESULT_LINES = 600
MAX_LOG_LINE_CHARS = 4096
MAILER_WRAPPER = "/usr/local/libexec/bedsetco-codex-mailer-send"
POSTMASTER = "postmaster@bedsetco.com"
SALES_ADDRESS = "sales@bedsetco.com"
ALLOWED_HEADERS = {"Message-ID", "Subject", "From", "To"}
ALLOWED_MAILBOXES = {"INBOX", "Sent", "Junk", "Trash"}
QUEUE_ID_RE = re.compile(r"postfix/[^:]+:\s+([A-Za-z0-9]+):")
QUEUED_AS_RE = re.compile(r"\bqueued(?:\s+as|_as)=?\s*([A-Za-z0-9]+)\b", re.I)
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")


class AuditError(Exception):
    pass


def run_checked(argv: list[str], timeout: int = 15) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            argv,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"},
        )
    except subprocess.TimeoutExpired as exc:
        raise AuditError(f"command timed out: {argv[0]}") from exc


def file_sha256(path: str) -> str | None:
    try:
        digest = hashlib.sha256()
        with open(path, "rb") as handle:
            for chunk in iter(lambda: handle.read(131072), b""):
                digest.update(chunk)
        return digest.hexdigest()
    except OSError:
        return None


def log_paths() -> list[str]:
    candidates = [path for path in glob.glob("/var/log/mail.log*") if os.path.isfile(path)]
    return sorted(candidates, key=lambda path: (os.path.getmtime(path), path))


def iter_log_lines(paths: Iterable[str]) -> Iterable[str]:
    for path in paths:
        opener = gzip.open if path.endswith(".gz") else open
        try:
            with opener(path, "rt", encoding="utf-8", errors="replace") as handle:
                for raw_line in handle:
                    yield raw_line.rstrip("\r\n")[:MAX_LOG_LINE_CHARS]
        except (OSError, EOFError):
            continue


def queue_ids(line: str) -> set[str]:
    found: set[str] = set()
    match = QUEUE_ID_RE.search(line)
    if match:
        found.add(match.group(1))
    for queued_match in QUEUED_AS_RE.finditer(line):
        found.add(queued_match.group(1))
    return found


def correlated_lines(seed_match: str) -> tuple[list[str], list[str]]:
    paths = log_paths()
    lines = list(iter_log_lines(paths))
    lowered = seed_match.casefold()
    selected: set[int] = {index for index, line in enumerate(lines) if lowered in line.casefold()}
    known_ids: set[str] = set()
    work: deque[str] = deque()

    for index in selected:
        for queue_id in queue_ids(lines[index]):
            if queue_id not in known_ids:
                known_ids.add(queue_id)
                work.append(queue_id)

    while work:
        current = work.popleft()
        for index, line in enumerate(lines):
            if index in selected or current not in line:
                continue
            selected.add(index)
            for queue_id in queue_ids(line):
                if queue_id not in known_ids:
                    known_ids.add(queue_id)
                    work.append(queue_id)

    ordered = [lines[index] for index in sorted(selected)]
    if len(ordered) > MAX_RESULT_LINES:
        ordered = ordered[-MAX_RESULT_LINES:]
    return ordered, sorted(known_ids)


def is_external_accept(line: str) -> bool:
    lowered = line.casefold()
    if "postfix/smtp[" not in lowered or "status=sent" not in lowered:
        return False
    relay_match = re.search(r"\brelay=([^,\s]+)", lowered)
    if not relay_match:
        return False
    relay = relay_match.group(1)
    local_markers = ("127.0.0.1", "localhost", "mail.bedsetco.com", ":10024", ":10026")
    return not any(marker in relay for marker in local_markers)


def failure_seen(line: str) -> bool:
    lowered = line.casefold()
    return bool(
        re.search(r"\bstatus=(bounced|deferred|expired)\b", lowered)
        or "postfix/bounce[" in lowered
        or "delivery temporarily suspended" in lowered
    )


def operation_health() -> dict[str, Any]:
    services: dict[str, str] = {}
    for service in ("postfix", "dovecot", "nginx"):
        result = run_checked(["/usr/bin/systemctl", "is-active", service], timeout=5)
        services[service] = result.stdout.strip() or result.stderr.strip() or "unknown"

    queue_result = run_checked(["/usr/sbin/postqueue", "-p"], timeout=10)
    queue_text = (queue_result.stdout + queue_result.stderr).strip()
    queue_empty = "Mail queue is empty" in queue_text

    paths = log_paths()
    return {
        "operation": "health",
        "checked_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "hostname": socket.getfqdn(),
        "services": services,
        "services_healthy": all(value == "active" for value in services.values()),
        "mailer_wrapper": {
            "path": MAILER_WRAPPER,
            "exists": os.path.isfile(MAILER_WRAPPER),
            "sha256": file_sha256(MAILER_WRAPPER),
        },
        "queue": {
            "empty": queue_empty,
            "command_exit_code": queue_result.returncode,
            "summary": queue_text[-4000:],
        },
        "log_files": [os.path.basename(path) for path in paths],
    }


def require_text(request: dict[str, Any], name: str, max_length: int) -> str:
    value = request.get(name)
    if not isinstance(value, str):
        raise AuditError(f"{name} must be a string")
    value = value.strip()
    if not value or len(value) > max_length or CONTROL_RE.search(value):
        raise AuditError(f"{name} is empty or invalid")
    return value


def operation_lookup(request: dict[str, Any]) -> dict[str, Any]:
    needle = require_text(request, "needle", 200)
    lines, ids = correlated_lines(needle)
    accepts = [line for line in lines if is_external_accept(line)]
    failures = [line for line in lines if failure_seen(line)]
    return {
        "operation": "lookup",
        "needle": needle,
        "queue_ids": ids,
        "matched_line_count": len(lines),
        "external_accepted": bool(accepts),
        "external_accept_lines": accepts[-20:],
        "failure_seen": bool(failures),
        "failure_lines": failures[-20:],
        "lines": lines,
    }


def operation_recent_outbound() -> dict[str, Any]:
    lines, ids = correlated_lines(f"from=<{SALES_ADDRESS}>")
    accepts = [line for line in lines if is_external_accept(line)]
    failures = [line for line in lines if failure_seen(line)]
    return {
        "operation": "recent_outbound",
        "sender": SALES_ADDRESS,
        "queue_ids": ids,
        "matched_line_count": len(lines),
        "external_accept_count": len(accepts),
        "failure_count": len(failures),
        "lines": lines,
    }


def operation_mailbox_lookup(request: dict[str, Any]) -> dict[str, Any]:
    mailbox = request.get("mailbox", "INBOX")
    if mailbox not in ALLOWED_MAILBOXES:
        raise AuditError("mailbox is not allowed")
    header = request.get("header", "Message-ID")
    if header not in ALLOWED_HEADERS:
        raise AuditError("header is not allowed")
    value = require_text(request, "value", 300)
    fields = "mailbox uid hdr.from hdr.to hdr.subject hdr.message-id date.received"
    result = run_checked(
        [
            "/usr/bin/doveadm",
            "fetch",
            "-u",
            POSTMASTER,
            fields,
            "mailbox",
            mailbox,
            "HEADER",
            header,
            value,
        ],
        timeout=15,
    )
    output = result.stdout.strip()
    return {
        "operation": "mailbox_lookup",
        "mailbox": mailbox,
        "header": header,
        "value": value,
        "found": bool(output),
        "command_exit_code": result.returncode,
        "output": output[-12000:],
        "error": result.stderr.strip()[-2000:],
    }


def read_request() -> dict[str, Any]:
    raw = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
    if len(raw) > MAX_REQUEST_BYTES:
        raise AuditError("request is too large")
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise AuditError("request must be valid UTF-8 JSON") from exc
    if not isinstance(value, dict):
        raise AuditError("request must be a JSON object")
    return value


def main() -> int:
    try:
        request = read_request()
        operation = request.get("operation")
        if operation == "health":
            response = operation_health()
        elif operation == "lookup":
            response = operation_lookup(request)
        elif operation == "recent_outbound":
            response = operation_recent_outbound()
        elif operation == "mailbox_lookup":
            response = operation_mailbox_lookup(request)
        else:
            raise AuditError("unsupported operation")
        response = {"ok": True, **response}
        print(json.dumps(response, ensure_ascii=False, separators=(",", ":")))
        return 0
    except AuditError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, separators=(",", ":")))
        return 2
    except Exception as exc:  # Keep the forced command closed on unexpected errors.
        print(json.dumps({"ok": False, "error": f"internal audit error: {type(exc).__name__}"}, separators=(",", ":")))
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
